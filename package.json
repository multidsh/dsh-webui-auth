{
  "name": "dsh-webui-auth",
  "version": "0.3.7",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "lib/desktop-adapter.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "auth",
    "login",
    "gate"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "description": "Persistent WebUI authentication plugin for DeepSeek Harness: configure an account/password in Settings, then accessing the WebUI requires login. Zero dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multidsh/dsh-webui-auth.git"
  },
  "homepage": "https://github.com/multidsh/dsh-webui-auth#readme",
  "bugs": {
    "url": "https://github.com/multidsh/dsh-webui-auth/issues"
  },
  "author": "Yuuz12",
  "contributors": [
    {
      "name": "multidsh"
    }
  ]
}
